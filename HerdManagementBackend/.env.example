# Konfiguracja backendu. Skopiuj do .env i uzupelnij wlasnymi wartosciami.
# Plik .env NIE powinien trafic do repozytorium.

DATABASE_URL=sqlite:///./herd.db

# --- Asystent LLM (zadanie 8) ---
# Klucz API do modelu jezykowego. Bez niego API dziala,
# ale /assistant/chat zwraca 503, a /assistant/status configured=false.
LLM_API_KEY=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
# Model. Na czas developmentu i testow recznych oplaca sie claude-haiku-4-5
# (~5x tansze od Opusa przy tym samym zestawie narzedzi); na demo/obrone
# wroc na claude-opus-5 - lepiej radzi sobie z wieloetapowymi pytaniami.
LLM_MODEL=claude-haiku-4-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Serwerowy fallback na odmowe modelu - wymaga konta z dostepem do bety.
LLM_REFUSAL_FALLBACK=false
