# Szablon konfiguracji backendu. Należy skopiować go do pliku .env i uzupełnić wartości.
# Plik .env zawiera dane poufne i nie może być objęty kontrolą wersji.

DATABASE_URL=sqlite:///./herd.db

# Asystent LLM
# Klucz API modelu językowego. W razie jego braku /assistant/chat zwraca kod 503,
# a /assistant/status zwraca configured=false.
LLM_API_KEY=
# Identyfikator modelu. claude-haiku-4-5 ogranicza koszty w trakcie rozwoju;
# claude-opus-5 zapewnia lepszą obsługę pytań wieloetapowych.
LLM_MODEL=claude-haiku-4-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Obsługa odmowy modelu po stronie serwera (funkcja beta).
LLM_REFUSAL_FALLBACK=false
